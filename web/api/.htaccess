# Solo se puede llamar al router. El archivo que lee las claves no se sirve.
<FilesMatch "^(gemini)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
</IfModule>
