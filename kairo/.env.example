# Copia este archivo a .env.local y rellena los valores.
# En Vercel se ponen en Settings → Environment Variables.

# --- Supabase (cuentas, perfiles y créditos) --------------------
# Project Settings → API  (o "Data API" en los paneles nuevos)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Los tres cerebros ------------------------------------------
# OJO: ninguna lleva NEXT_PUBLIC_ delante. Estas claves NO pueden
# llegar al navegador: solo las usa el servidor en /api/chat.
#
# Con una sola de las tres, Kairo funciona. Los proveedores sin
# clave desaparecen de las cadenas y no se nota nada.

# Gemini: velocidad. Se saca gratis en https://aistudio.google.com/apikey
# Es el único que acepta un filtro de contenido por petición, así que
# hace falta si quieres que el modo niño tenga su capa extra.
GEMINI_API_KEY=

# Claude: código y textos largos. Manda en Forja y en MEGA.
# https://console.anthropic.com  ·  de pago desde el primer mensaje.
ANTHROPIC_API_KEY=

# GPT: razonamiento. Segundo en Forja y en MEGA.
# https://platform.openai.com/api-keys  ·  de pago desde el primer mensaje.
OPENAI_API_KEY=

# --- Un cuarto de repuesto, el que tú quieras ---------------------
# Cuando los servidores de Google están saturados y no tienes las otras
# dos claves, no hay a quién preguntar. Esto es la red de seguridad.
#
# Vale CUALQUIER proveedor que hable como OpenAI en /chat/completions,
# que son casi todos. Varios tienen capa gratuita: mira las condiciones
# de hoy en su web antes de fiarte, que las cambian cada poco.
#   Groq        https://console.groq.com        (muy rápido)
#   OpenRouter  https://openrouter.ai           (muchos modelos)
#   Mistral     https://console.mistral.ai
#
# Los tres van al FINAL de todas las cadenas: solo entran si los demás
# han fallado. Y no entran nunca en modo niño, porque no hay forma de
# pedirles un filtro de contenido.
# KAIRO_EXTRA_URL=https://api.groq.com/openai/v1
# KAIRO_EXTRA_KEY=
# KAIRO_EXTRA_MODELOS=modelo-uno,modelo-dos

# --- Buscar en internet -----------------------------------------
# No hay nada que poner. La búsqueda va incluida con GEMINI_API_KEY:
# Kairo busca en Google, abre los enlaces que le pegues y consulta los
# sitios de Google Maps cuando la pregunta lo pide, y enseña debajo de
# la respuesta las páginas que ha usado.
#
# Solo si alguna vez quieres apagarla del todo (por cuota o por lo que
# sea), pon esto a 1. Con ella apagada, Kairo vuelve a responder de
# memoria y avisa de que no ha podido comprobar nada.
# KAIRO_SIN_BUSQUEDA=1

# --- Opcional: entrar con Google --------------------------------
# El botón solo aparece si esto vale 1, y solo debe valer 1 cuando
# hayas dado de alta Google en Supabase (Authentication → Providers).
# Si no, Supabase responde "provider is not enabled".
# NEXT_PUBLIC_LOGIN_GOOGLE=1

# --- Opcional: qué modelo atiende cada nivel --------------------
# Lleva el proveedor delante. Sin prefijo se entiende Gemini.
# Abre /api/estado para ver qué modelos acepta CADA una de tus
# claves: esa lista manda sobre cualquier nombre escrito a mano.
# KAIRO_MODELO_RAPIDO=gemini-flash-lite-latest
# KAIRO_MODELO_ESTANDAR=gemini-flash-latest
# KAIRO_MODELO_FORJA=claude:claude-opus-5
# KAIRO_MODELO_MAXIMO=claude:claude-opus-5
#
# Forja cuesta 20 créditos y por defecto va a Claude Opus, que es el
# mejor programando y también el más caro. Si al mirar la factura ves
# que no te salen las cuentas, KAIRO_MODELO_FORJA=claude:claude-sonnet-5
# cuesta menos de la mitad.

# --- Cobrar (Paso 4) -------------------------------------------
# Todo esto es opcional. Sin ello, los botones de precios llevan a
# crear una cuenta y no se rompe nada.
#
# ⚠️  SUPABASE_SERVICE_ROLE_KEY se salta TODA la seguridad de la base
# de datos. Va sin NEXT_PUBLIC_ delante, y ese detalle es la diferencia
# entre que la use solo el servidor y que se la descargue el navegador
# de cualquiera. Solo la usa /api/pagos/webhook. No la pegues en ningún
# sitio más, ni se la pases a nadie.
# SUPABASE_SERVICE_ROLE_KEY=

# El secreto que firma los avisos. Lo eliges tú al crear el webhook en
# la tienda, y tiene que ser el mismo en los dos sitios. Sin él,
# cualquiera podría decirle a tu web que ha pagado.
# LEMON_WEBHOOK_SECRET=

# Los enlaces de compra de cada producto, tal cual te los da la tienda.
# LEMON_CHECKOUT_PLUS=
# LEMON_CHECKOUT_PLUS_ANUAL=
# LEMON_CHECKOUT_SUPREME=
# LEMON_CHECKOUT_SUPREME_ANUAL=
# LEMON_CHECKOUT_PACK_500=
# LEMON_CHECKOUT_PACK_2000=

# El número de variante de cada uno. Es lo que viene en el aviso de
# pago, y sin esta tabla no hay forma de saber qué ha comprado.
# LEMON_VARIANTE_PLUS=
# LEMON_VARIANTE_PLUS_ANUAL=
# LEMON_VARIANTE_SUPREME=
# LEMON_VARIANTE_SUPREME_ANUAL=
# LEMON_VARIANTE_PACK_500=
# LEMON_VARIANTE_PACK_2000=

# Enseña los botones de comprar. Ponlo a 1 solo cuando hayas hecho una
# compra de prueba y hayas visto el plan cambiar de verdad.
# NEXT_PUBLIC_TIENDA=1

# Sin las variables de Supabase la app arranca en modo demo con
# datos de ejemplo. Sin ninguna clave de IA el chat responde con un
# aviso en vez de con la IA.
#
# NUNCA pongas aquí la clave service_role de Supabase.
