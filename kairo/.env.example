# Copia este archivo a .env.local y rellena los valores.
# En Vercel se ponen en Settings → Environment Variables.

# --- Supabase (cuentas, perfiles y créditos) --------------------
# Project Settings → API  (o "Data API" en los paneles nuevos)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Los tres cerebros ------------------------------------------
# OJO: ninguna lleva NEXT_PUBLIC_ delante. Estas claves NO pueden
# llegar al navegador: solo las usa el servidor en /api/chat.
#
# Con una sola de las tres, Kairo funciona. Los proveedores sin
# clave desaparecen de las cadenas y no se nota nada.

# Gemini: velocidad. Se saca gratis en https://aistudio.google.com/apikey
# Es el único que acepta un filtro de contenido por petición, así que
# hace falta si quieres que el modo niño tenga su capa extra.
GEMINI_API_KEY=

# Claude: código y textos largos. Manda en Forja y en MEGA.
# https://console.anthropic.com  ·  de pago desde el primer mensaje.
ANTHROPIC_API_KEY=

# GPT: razonamiento. Segundo en Forja y en MEGA.
# https://platform.openai.com/api-keys  ·  de pago desde el primer mensaje.
OPENAI_API_KEY=

# --- Opcional: entrar con Google --------------------------------
# El botón solo aparece si esto vale 1, y solo debe valer 1 cuando
# hayas dado de alta Google en Supabase (Authentication → Providers).
# Si no, Supabase responde "provider is not enabled".
# NEXT_PUBLIC_LOGIN_GOOGLE=1

# --- Opcional: qué modelo atiende cada nivel --------------------
# Lleva el proveedor delante. Sin prefijo se entiende Gemini.
# Abre /api/estado para ver qué modelos acepta CADA una de tus
# claves: esa lista manda sobre cualquier nombre escrito a mano.
# KAIRO_MODELO_RAPIDO=gemini-flash-lite-latest
# KAIRO_MODELO_ESTANDAR=gemini-flash-latest
# KAIRO_MODELO_FORJA=claude:claude-opus-5
# KAIRO_MODELO_MAXIMO=claude:claude-opus-5
#
# Forja cuesta 20 créditos y por defecto va a Claude Opus, que es el
# mejor programando y también el más caro. Si al mirar la factura ves
# que no te salen las cuentas, KAIRO_MODELO_FORJA=claude:claude-sonnet-5
# cuesta menos de la mitad.

# Sin las variables de Supabase la app arranca en modo demo con
# datos de ejemplo. Sin ninguna clave de IA el chat responde con un
# aviso en vez de con la IA.
#
# NUNCA pongas aquí la clave service_role de Supabase.
