# Copia este archivo a .env.local y rellena los valores.
# En Vercel se ponen en Settings → Environment Variables.

# --- Supabase (cuentas, perfiles y créditos) --------------------
# Project Settings → API  (o "Data API" en los paneles nuevos)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Gemini (el cerebro) ----------------------------------------
# Se saca gratis en https://aistudio.google.com/apikey
# OJO: sin NEXT_PUBLIC_ delante. Esta clave NO puede llegar al
# navegador: solo la usa el servidor en /api/chat.
GEMINI_API_KEY=

# --- Opcional: qué modelo atiende cada nivel --------------------
# Por defecto los tres usan modelos Flash, que son los únicos
# gratuitos desde abril de 2026. Cuando actives facturación en
# Google, cambia el máximo a gemini-pro-latest.
# KAIRO_MODELO_RAPIDO=gemini-flash-lite-latest
# KAIRO_MODELO_ESTANDAR=gemini-flash-latest
# KAIRO_MODELO_MAXIMO=gemini-flash-latest

# Sin las variables de Supabase la app arranca en modo demo con
# datos de ejemplo. Sin GEMINI_API_KEY el chat responde con un
# aviso en vez de con la IA.
#
# NUNCA pongas aquí la clave service_role de Supabase.
