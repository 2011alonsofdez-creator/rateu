# Copia este archivo a .env.local y rellena los dos valores.
# En Vercel se ponen en Settings → Environment Variables.
#
# Los encuentras en tu proyecto de Supabase:
#   Project Settings → API  (o "Data API" en los paneles nuevos)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Sin estas variables la app arranca igual, en modo demo con datos de
# ejemplo. Así nunca se queda en blanco por una variable que falta.
#
# NUNCA pongas aquí la clave service_role. Este proyecto no la usa:
# todo pasa por la seguridad a nivel de fila de la base de datos.
